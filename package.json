{
  "name": "@el4cteo/discord-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets AI agents run a Discord bot: messages, DMs, channels, threads, roles, members, moderation, live events and bulk operations.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "discord-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "discord-bot",
    "claude",
    "claude-code",
    "ai-agent",
    "llm-tools",
    "discord-api",
    "chatops",
    "moderation",
    "anthropic",
    "mcp-server",
    "typescript"
  ],
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "discord-api-types": "^0.38.55",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "author": "EL4CTEO",
  "homepage": "https://github.com/EL4CTEO/discord-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EL4CTEO/discord-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/EL4CTEO/discord-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
