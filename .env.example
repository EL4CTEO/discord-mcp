# Required: bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: default server (name or ID) so tools can omit `guild`
DISCORD_DEFAULT_GUILD=

# Optional: set to true to enable ban / kick / timeout / delete / bulk-delete tools
DISCORD_ALLOW_DESTRUCTIVE=false

# Optional tuning
DISCORD_REQUEST_TIMEOUT_MS=15000
DISCORD_MAX_RESPONSE_CHARS=25000
DISCORD_GATEWAY_IDLE_MS=120000
DISCORD_EVENT_BUFFER=200
DISCORD_BATCH_CONCURRENCY=4

# Optional: set false if you cannot enable privileged gateway intents in the portal
DISCORD_PRIVILEGED_INTENTS=true
